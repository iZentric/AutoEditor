# COPIEAZĂ fișierul ăsta ca ".env" și pune cheia ta (gratuită)
# 1. intri pe aistudio.google.com/apikey
# 2. „Create API key" -> copiezi
# 3. creezi fișierul .env lângă autoeditor.py cu linia:
GEMINI_API_KEY=cheia_ta_aici
# Identificarea exacta a melodiilor este optionala; creeaza token direct la audd.io.
# Nu pune tokenul real in acest fisier de exemplu. Adauga-l numai in .env-ul tau local.
# AUDD_API_TOKEN=
# Model audio separat optional; altfel sunt incercate modelele din GEMINI_MODEL.
# GEMINI_AUDIO_MODEL=gemini-2.5-flash
# modele (optional, cu virgule = fallback automat daca unul e aglomerat):
# GEMINI_MODEL=gemini-3.5-flash,gemini-3.8-flash,gemini-flash-latest
